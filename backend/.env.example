# Database
DATABASE_URL=postgresql+asyncpg://pulsecheck:pulsecheck_password@postgres:5432/pulsecheck

# Bolna API
BOLNA_API_KEY=your_bolna_api_key
BOLNA_AGENT_ID=your_bolna_agent_id
BOLNA_BASE_URL=https://api.bolna.dev

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=pulsecheck-uploads

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# Frontend
FRONTEND_URL=http://localhost:5173

# Webhook
WEBHOOK_SECRET=optional_webhook_secret_for_signature_verification

# App Config
APP_NAME=PulseCheck
APP_ENV=development
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_ENABLED=true
